# Copy to .env and adjust. .env is gitignored; never commit real keys.

# --- Client (used by banksync/ and the auditor engine) ---
# Local dev against the mock:
BANKSYNC_BASE_URL=http://10.0.2.2:8000
# Pick any random string you like (e.g. `openssl rand -hex 16`) — it must
# match BANKSYNC_MOCK_KEY below. This file is a template; your real .env
# (gitignored) holds the actual values.
BANKSYNC_API_KEY=change-me
BANKSYNC_BANK_ID=demo
BANKSYNC_ACCOUNT_ID=spending
# Set true if your network needs the system proxy for the live API.
BANKSYNC_TRUST_ENV=false

# --- Local mock server ---
# Must match BANKSYNC_API_KEY above when running against the local mock.
# Never put a real BankSync key here.
BANKSYNC_MOCK_KEY=change-me
