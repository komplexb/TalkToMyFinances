# Container image for the Cloud Run deployment of the Auditor & Curation API.
#
# Build context is the REPO ROOT (not backend/), because the auditor loads its
# LLM prompts from the repo-root prompts/ directory
# (auditor/prompt_templates.py: parents[2] / "prompts").
#
#   docker build -f backend/Dockerfile.auditor -t ttmf-auditor .
#   docker run --rm -p 8000:8000 -e GEMINI_API_KEY=<key> ttmf-auditor
#
# The image must contain, relative to WORKDIR /service:
#   /service/auditor/                the FastAPI app (uvicorn auditor.main:app)
#   /service/mock_banksync/data/     the frozen demo dataset (compute path reads
#                                    mock_banksync/data/transactions.json from disk)
#   /prompts/                        the shared .prompt templates (repo root;
#                                    /prompts is parents[2] of /service/auditor/)
#
# `uv sync --frozen --no-dev` pins the exact versions the tests ran against.
# GEMINI_API_KEY is optional at runtime: /compute works with no key; without
# a key /audit returns 500 (the app falls back to stub chips).

FROM ghcr.io/astral-sh/uv:python3.11-trixie-slim

WORKDIR /service
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

COPY backend/auditor/ ./auditor/
COPY backend/mock_banksync/data/ ./mock_banksync/data/
COPY prompts/ /prompts/

# Cloud Run sets PORT (default 8080); fall back to 8000 for local `docker run`.
EXPOSE 8000
CMD uv run uvicorn auditor.main:app --host 0.0.0.0 --port ${PORT:-8000}
